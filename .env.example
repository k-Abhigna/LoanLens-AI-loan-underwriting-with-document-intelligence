# Copy this file to .env and fill in ONE of the options. Never commit .env.

# Option 1: Google Gemini free tier - key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=180

# Option 2: local Ollama (free, runs on your PC) - https://ollama.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
